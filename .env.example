LISTEN_ADDR=:8080

# The application automatically detects a Pod ServiceAccount for in-cluster access.
# Outside a Pod, it uses FLEET_API_BASE_URL when set, otherwise $KUBECONFIG or ~/.kube/config.
# Local development: optionally select a kubeconfig file and context.
FLEET_KUBECONFIG=
FLEET_KUBECONTEXT=

# Direct Rancher/Kubernetes API override. Leave empty when using kubeconfig or in-cluster.
# Rancher Steve API: https://rancher.example.com/v1/fleet.cattle.io.bundles
# Kubernetes API: https://kubernetes.example.com/apis/fleet.cattle.io/v1alpha1/bundles
FLEET_API_BASE_URL=
FLEET_API_MODE=steve
FLEET_API_TOKEN=
FLEET_INSECURE_SKIP_TLS_VERIFY=false
FLEET_PAGE_SIZE=250
FLEET_CACHE_TTL_SECONDS=10

# Read live YAML only for resources indexed in BundleDeployment.status.resources.
# Secret values are always redacted. Disable when the Fleet identity must remain CRD-only.
MANAGED_OBJECTS_YAML_ENABLED=true

# Opt in to reading each Fleet Cluster's spec.kubeConfigSecret for downstream YAML.
# This requires Secret get permission in the management cluster.
MANAGED_OBJECTS_DOWNSTREAM_KUBECONFIGS=false

# Required to enable manual Bundle reconcile. Leave empty for read-only mode.
# Use a long random value and serve Fleet WebUI over HTTPS.
RECONCILE_AUTH_TOKEN=

# Fixed ntfy topic for all manual Bundle reconcile requests.
NTFY_BASE_URL=https://ntfy.example.com
NTFY_TOPIC=fleet-reconcile-REPLACE_WITH_RANDOM_TOPIC
NTFY_TOKEN=tk_REPLACE_ME

# Optional link embedded in the ntfy notification.
APP_BASE_URL=https://fleet.example.com
REQUEST_TIMEOUT_SECONDS=12
HTTP_READ_HEADER_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=90
HTTP_IDLE_TIMEOUT_SECONDS=60
